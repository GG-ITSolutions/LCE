---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Fonts from "../components/Fonts.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image } = Astro.props;
// The free GitHub Pages preview is a separate, non-canonical copy of the site — it must
// never get indexed by search engines instead of (or alongside) the real production domain.
const isPreviewBuild = process.env.DEPLOY_TARGET === "gh-pages";
const noindex = Astro.props.noindex || isPreviewBuild;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LU-City Entwicklungs-GmbH (LCE)",
  alternateName: "LCE",
  url: new URL("/", Astro.site).toString(),
  logo: new URL("/favicon.ico", Astro.site).toString(),
  description:
    "Kommunale Entwicklungsgesellschaft der Stadt Ludwigshafen und der GAG Ludwigshafen für die Zukunftsquartiere an der Helmut-Kohl-Allee.",
  email: "info@lce-ludwigshafen.de",
  telephone: "+49 621 5604-147",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Mundenheimer Str. 182",
    postalCode: "67061",
    addressLocality: "Ludwigshafen am Rhein",
    addressCountry: "DE",
  },
  parentOrganization: [
    { "@type": "Organization", name: "Stadt Ludwigshafen am Rhein" },
    { "@type": "Organization", name: "GAG Ludwigshafen" },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <script is:inline>
      // Synchron (blockierend) vor dem ersten Paint gesetzt: erst dadurch greifen
      // die [data-reveal]-Scroll-Animationen in global.css. Ohne JS bleibt der
      // Inhalt (mangels ".js"-Klasse) einfach immer sichtbar – kein Flackern möglich.
      document.documentElement.classList.add("js");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <Fonts />
    {!isPreviewBuild && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Shared accordion behaviour (Downloads, FAQ) – all collapsed by default,
      // CSS animates the open/close via grid-template-rows. `inert` keeps the
      // collapsed content out of tab order and the accessibility tree.
      const items = document.querySelectorAll<HTMLElement>(".accordion__item");
      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>(".accordion__trigger");
        const panelInner = item.querySelector<HTMLElement>(".accordion__panel-inner");
        if (!trigger) return;
        trigger.setAttribute("aria-expanded", "false");
        if (panelInner) panelInner.inert = true;
        trigger.addEventListener("click", () => {
          const open = item.classList.toggle("is-open");
          trigger.setAttribute("aria-expanded", String(open));
          if (panelInner) panelInner.inert = !open;
        });
      });

      // Gentle reveal for elements marked data-reveal, respecting reduced motion.
      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        reveals.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
