---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LU-City Entwicklungs-GmbH (LCE)",
  alternateName: "LCE",
  url: new URL("/", Astro.site).toString(),
  logo: new URL("/favicon.ico", Astro.site).toString(),
  description:
    "Kommunale Entwicklungsgesellschaft der Stadt Ludwigshafen und der GAG Ludwigshafen für die Zukunftsquartiere an der Helmut-Kohl-Allee.",
  email: "info@lce-ludwigshafen.de",
  telephone: "+49 621 5604-148",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Mundenheimer Str. 182",
    postalCode: "67061",
    addressLocality: "Ludwigshafen am Rhein",
    addressCountry: "DE",
  },
  parentOrganization: [
    { "@type": "Organization", name: "Stadt Ludwigshafen am Rhein" },
    { "@type": "Organization", name: "GAG Ludwigshafen" },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/SourceSansPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DINOffc-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
