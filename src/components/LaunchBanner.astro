---
import { withBase } from "../lib/paths";
---

<div class="launch-banner" id="launch-banner">
  <div class="container launch-banner__inner">
    <svg class="launch-banner__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="16" x2="12" y2="11" />
      <line x1="12" y1="8" x2="12.01" y2="8" />
    </svg>
    <p class="launch-banner__text">
      Willkommen auf unserer neuen Website – online seit dem 01.08.2026! Vereinzelt können
      noch Fehler auftreten oder Inhalte sind noch nicht zu 100&nbsp;% geprüft. Entdecken Sie
      etwas? <a href={withBase("/kontakt")}>Kontaktieren Sie uns</a> gerne – auch über
      positives Feedback zu unserer neuen Seite freuen wir uns!
    </p>
    <button type="button" class="launch-banner__close" id="launch-banner-close" aria-label="Hinweis schließen">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>
</div>

<style>
  .launch-banner {
    background: var(--color-secondary);
    color: #fff;
  }
  .launch-banner__inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-block: 0.7rem;
  }
  .launch-banner__icon {
    flex-shrink: 0;
    color: var(--color-highlight);
  }
  .launch-banner__text {
    margin: 0;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .launch-banner__text a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .launch-banner__text a:hover {
    color: var(--color-highlight);
  }
  .launch-banner__close {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 999px;
    transition: color var(--transition), background-color var(--transition);
  }
  .launch-banner__close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
  }
  @media (max-width: 700px) {
    .launch-banner__inner {
      align-items: flex-start;
    }
    .launch-banner__icon {
      margin-top: 0.15rem;
    }
  }
</style>

<script>
  // Merkt sich das Schließen dauerhaft (localStorage), damit der Hinweis
  // wiederkehrenden Besucher:innen nicht bei jedem Aufruf erneut angezeigt wird.
  const KEY = "lce-launch-banner-dismissed";
  const banner = document.getElementById("launch-banner");
  const closeBtn = document.getElementById("launch-banner-close");

  if (banner) {
    if (localStorage.getItem(KEY) === "1") {
      banner.remove();
    } else {
      closeBtn?.addEventListener("click", () => {
        banner.remove();
        localStorage.setItem(KEY, "1");
      });
    }
  }
</script>
