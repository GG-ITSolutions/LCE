---
import sourceLight from "../assets/fonts/SourceSansPro-Light.woff2?url";
import sourceRegular from "../assets/fonts/SourceSansPro-Regular.woff2?url";
import sourceBold from "../assets/fonts/SourceSansPro-Bold.woff2?url";

// Generic family name ("LCE Text") decouples the typeface from the rest of the
// codebase: to swap a font, replace the woff2 imports above and the src URLs here —
// nothing else changes, because all styles use the --font-heading / --font-body
// tokens in global.css, which both point at this family (Source Sans Pro).
const fontFaceCss = `
  @font-face { font-family: "LCE Text"; src: url("${sourceLight}") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: "LCE Text"; src: url("${sourceRegular}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "LCE Text"; src: url("${sourceBold}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
`;
---

<link rel="preload" href={sourceRegular} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sourceBold} as="font" type="font/woff2" crossorigin />
<style set:html={fontFaceCss} />
