---
import { Image } from "astro:assets";
import logo from "../assets/images/Logo-LCE-2048-x-818-1.png";
import { withBase } from "../lib/paths";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/ueber-uns", label: "Über Uns" },
  { href: "/zukunftsquartiere", label: "Zukunftsquartiere" },
  { href: "/kontakt", label: "Kontakt" },
];

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname.replace(/\/index\.html$/, "/");
const currentPath = rawPath.startsWith(base) ? rawPath.slice(base.length - 1) || "/" : rawPath;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase("/")} class="site-header__logo" aria-label="LCE – Startseite">
      <Image src={logo} alt="LCE Logo" width={160} height={64} />
    </a>

    <button
      id="nav-toggle"
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menü öffnen</span>
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-header__nav" aria-label="Hauptnavigation">
      <ul>
        {
          navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            return (
              <li>
                <a href={withBase(item.href)} aria-current={isActive ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a href={withBase("/kontakt")} class="btn btn-primary site-header__cta">Kontakt für Investoren</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }
  .site-header__logo img {
    height: 2.5rem;
    width: auto;
  }
  .site-header__toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-secondary);
    position: relative;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-header__burger::before,
  .site-header__burger::after {
    content: "";
    position: absolute;
  }
  .site-header__burger::before {
    top: -7px;
  }
  .site-header__burger::after {
    top: 7px;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.25rem);
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    transition: color var(--transition);
  }
  .site-header__cta {
    white-space: nowrap;
  }

  /* Desktop nav: animated underline on hover + current page */
  @media (min-width: 861px) {
    .site-header__nav ul a {
      position: relative;
      padding-block: 0.25rem;
    }
    .site-header__nav ul a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 2px;
      background: var(--color-highlight);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transition);
    }
    .site-header__nav ul a:hover {
      color: var(--color-secondary);
    }
    .site-header__nav ul a:hover::after,
    .site-header__nav ul a[aria-current="page"]::after {
      transform: scaleX(1);
    }
    .site-header__nav ul a[aria-current="page"] {
      color: var(--color-secondary);
    }
  }

  @media (max-width: 860px) {
    .site-header__toggle {
      display: block;
    }
    .site-header__nav {
      position: fixed;
      inset: 4.2rem 0 0 0;
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem;
      gap: 1.5rem;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.2s ease, opacity 0.2s ease;
      overflow-y: auto;
    }
    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .site-header__nav a {
      display: block;
      padding: 0.85rem 0.25rem;
      border-bottom: 1px solid var(--color-border);
    }
    .site-header__nav a[aria-current="page"] {
      color: var(--color-primary-dark);
    }
    .site-header__nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .site-header[data-nav-open] .site-header__burger {
      background: transparent;
    }
    .site-header[data-nav-open] .site-header__burger::before {
      top: 0;
      transform: rotate(45deg);
    }
    .site-header[data-nav-open] .site-header__burger::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  const header = toggle?.closest(".site-header");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    if (isOpen) {
      header?.setAttribute("data-nav-open", "");
    } else {
      header?.removeAttribute("data-nav-open");
    }
  });

  nav?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).tagName === "A") {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      header?.removeAttribute("data-nav-open");
    }
  });
</script>
