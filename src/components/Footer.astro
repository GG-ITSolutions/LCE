---
import { Image } from "astro:assets";
import logo from "../assets/images/Logo-LCE-footer.png";
import { withBase } from "../lib/paths";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/ueber-uns", label: "Über Uns" },
  { href: "/zukunftsquartiere", label: "Zukunftsquartiere" },
  { href: "/kontakt", label: "Kontakt" },
];
const year = 2026;
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <a href={withBase("/")} class="site-footer__logo" aria-label="LCE – Startseite">
      <Image src={logo} alt="LCE Logo" width={168} height={56} />
    </a>
    <nav aria-label="Footer-Navigation">
      <ul class="site-footer__nav">
        {navItems.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {year} LU-City Entwicklungs-GmbH (LCE)</p>
    <ul class="site-footer__legal">
      <li><a href={withBase("/impressum")}>Impressum</a></li>
      <li><a href={withBase("/datenschutz")}>Datenschutzerklärung</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-secondary);
    color: rgba(255, 255, 255, 0.85);
    margin-top: var(--section-space);
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f7f7fc; /* matches the logo's own background → seamless */
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .site-footer__logo:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
  }
  .site-footer__logo img {
    display: block;
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__nav a {
    position: relative;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    padding-bottom: 3px;
  }
  /* Animierter Unterstrich wie in der Kopfnavigation */
  .site-footer__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-highlight);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .site-footer__nav a:hover {
    color: var(--color-highlight);
  }
  .site-footer__nav a:hover::after {
    transform: scaleX(1);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }
  .site-footer__bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
  }
  .site-footer__legal {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__legal a {
    position: relative;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    padding-bottom: 3px;
  }
  .site-footer__legal a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-highlight);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .site-footer__legal a:hover {
    color: var(--color-highlight);
  }
  .site-footer__legal a:hover::after {
    transform: scaleX(1);
  }
</style>
