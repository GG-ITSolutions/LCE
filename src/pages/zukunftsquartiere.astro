---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { withBase } from "../lib/paths";
import { Image } from "astro:assets";
import karteImage from "../assets/images/67c59b1209c3d1134e556e13_Karte.avif";
import wohnenIcon from "../assets/images/Wohnen.avif";
import arbeitenIcon from "../assets/images/Arbeiten.avif";
import bildungIcon from "../assets/images/Bildung.avif";
import mobilitaetIcon from "../assets/images/Mobilitaet.avif";
import workshopPhoto from "../assets/images/685ab12490a014f4b5368d1d__3MH8034.jpg";
import adeptRendering from "../assets/images/Design-ohne-Titel-36.png";

const bausteine = [
  {
    icon: wohnenIcon,
    title: "Wohnen",
    text: "Neue, vielfältige Wohnangebote für unterschiedliche Bedarfe – urban, durchmischt und gut angebunden.",
  },
  {
    icon: arbeitenIcon,
    title: "Arbeiten",
    text: "Flächen für Gewerbe, Dienstleistung und Innovation, die wirtschaftliche Perspektiven im Quartier schaffen.",
  },
  {
    icon: bildungIcon,
    title: "Bildung",
    text: "Räume für Bildung und Begegnung als soziale Infrastruktur eines lebendigen Stadtquartiers.",
  },
  {
    icon: mobilitaetIcon,
    title: "Mobilität",
    text: "Eine zukunftsfähige, vernetzte Mobilität entlang der neuen Helmut-Kohl-Allee.",
  },
];

const standortvorteile = [
  {
    title: "Zentrale Lage",
    text: "Die Lage im Stadtgebiet Ludwigshafens schafft unmittelbare Nähe zu bestehenden urbanen Strukturen und zentralen Innenstadtbereichen.",
  },
  {
    title: "Lage im Herzen der Metropolregion",
    text: "Die Einbindung in das Zentrum der Metropolregion Rhein-Neckar bildet den funktionalen und wirtschaftlichen Kontext des Standorts und stärkt seine regionale Verflechtung.",
  },
  {
    title: "Starke Anbindung",
    text: "Die Anbindung an überregionale Verkehrsnetze schafft attraktive Voraussetzungen für eine vielfältige Nutzung und nachhaltige Wertentwicklung.",
  },
  {
    title: "Seltene Entwicklungschance",
    text: "Die Flächen bieten die seltene Möglichkeit, innerstädtische Entwicklungsräume in dieser Größenordnung neu zu gestalten und langfristig zu positionieren.",
  },
];

const downloads = [
  {
    category: "Dokumentationen",
    items: [
      {
        title: "Abschlussdokumentation Werkstattverfahren",
        text: "Eine umfassende Dokumentation zum Werkstattverfahren – mit allen Planungsentwürfen und Hintergrundinformationen rund um das Verfahren.",
        href: withBase("/documents/Abschlussdokumentation_Werkstattverfahren.pdf"),
      },
      {
        title: "Dokumentation Online-Dialog Werkstattverfahren",
        text: "Eine detaillierte Auswertung eines Online-Beteiligungsformats im Vorfeld des Werkstattverfahrens.",
        href: withBase("/documents/dokumentation_onlinedialog_neues_stadtquartier.pdf"),
      },
    ],
  },
  {
    category: "Präsentationen",
    items: [
      {
        title: "Abschlusspräsentation ADEPT Werkstattverfahren",
        text: "Die beim Werkstattverfahren gezeigte finale Präsentation zum Zielkonzept des Teams ADEPT.",
        href: withBase("/documents/01_LU_LCE_ASW_ADEPT-2.pdf"),
      },
      {
        title: "Präsentation Stadtrat am 22.09.2025",
        text: "Die in der Stadtratssitzung am 22.09.2025 gezeigte Rahmenpräsentation zur Vorstellung der Ergebnisse des Werkstattverfahrens.",
        href: withBase("/documents/Praesentation-Stadtrat_inkl_ADEPT.pdf"),
      },
    ],
  },
  {
    category: "Pressemitteilungen",
    items: [
      {
        title: "Pressemeldung Werkstattverfahren",
        text: "Pressemeldung zur Auftaktwerkstatt am 12.09.2024. Mit dieser Auftaktveranstaltung begann das rund viermonatige Werkstattverfahren.",
        href: withBase("/documents/pressemeldung_werkstattverfahren_neues_stadtquartier.pdf"),
      },
    ],
  },
];
---

<BaseLayout
  title="Zukunftsquartiere an der Helmut-Kohl-Allee"
  description="Die Zukunftsquartiere rund um die geplante Helmut-Kohl-Allee zählen zu den bedeutendsten Stadtentwicklungsprojekten in Ludwigshafen und der Metropolregion Rhein-Neckar."
>
  <section class="section hero">
    <div class="container hero__grid">
      <div>
        <h1>Zukunftsquartiere rund um die Helmut-Kohl-Allee</h1>
        <p class="lead">
          Die Zukunftsquartiere rund um die geplante Helmut-Kohl-Allee zählen zu den
          bedeutendsten Stadtentwicklungsprojekten in Ludwigshafen und der Metropolregion
          Rhein-Neckar. Entlang einer der wichtigsten Verkehrsachsen der Region entstehen neue
          urbane Räume mit hoher städtebaulicher, wirtschaftlicher und gesellschaftlicher
          Relevanz.
        </p>
        <div class="hero__actions">
          <a href={withBase("/kontakt")} class="btn btn-primary">Kontakt für Investoren</a>
          <a href={withBase("/ueber-uns")} class="btn btn-secondary btn-on-light">Über die LCE</a>
        </div>
      </div>
      <figure class="hero__figure">
        <Image src={karteImage} alt="Stadtgrundkarte der Zukunftsquartiere an der Helmut-Kohl-Allee" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, 45vw" quality={88} />
        <figcaption>Stadtgrundkarte – Stadtverwaltung Ludwigshafen am Rhein</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Projektüberblick" title="Ein Quartier aus vier Bausteinen">
        <p class="lead">
          Mit den Zukunftsquartieren werden zentrale innerstädtische Flächen neu geordnet und
          langfristig entwickelt: leistungsfähige, zukunftsorientierte Quartiere, die Wohnen,
          Arbeiten, Bildung, Mobilität und Freiräume in einem integrierten Ansatz verbinden.
        </p>
      </SectionHeader>

      <div class="grid grid-4 bausteine">
        {
          bausteine.map((item) => (
            <div class="card bausteine__item">
              <Image src={item.icon} alt="" aria-hidden="true" width={64} height={64} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>

      <p class="bausteine__note">
        Die Lage entlang der Helmut-Kohl-Allee bietet besondere Potenziale: Als zentrale
        Verkehrsachse der Metropolregion Rhein-Neckar schafft sie neue Sichtbarkeit,
        Erreichbarkeit und wirtschaftliche Perspektiven, vernetzt die nördliche und südliche
        Innenstadt und stärkt über die Erweiterung des Friedensparks die klimatische und
        freiräumliche Qualität der Innenstadt.
      </p>
    </div>
  </section>

  <section class="section section-muted" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Standort" title="Standortvorteile">
        <p class="lead">
          Die Zukunftsquartiere verfügen über einen Standort mit besonderen
          Entwicklungschancen: zentral in Ludwigshafen am Rhein gelegen und im Herzen der
          Metropolregion Rhein-Neckar verankert.
        </p>
      </SectionHeader>
      <div class="grid grid-2">
        {
          standortvorteile.map((item, index) => (
            <div class="card standort-card">
              <span class="standort-card__num">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Wie geht es weiter?" title="Planungsstand und Zeithorizont" />

      <div class="milestone">
        <span class="milestone__year">2032</span>
        <p>
          Zieljahr für die Fertigstellung der Helmut-Kohl-Allee. Die Entwicklung der
          Zukunftsquartiere erfolgt schrittweise und ist eng an den Rückbau der Hochstraße
          Nord sowie den Neubau der Allee gekoppelt.
        </p>
      </div>

      <div class="planungsstand">
        <div class="planungsstand__row">
          <div class="planungsstand__text">
            <h3>Vom Werkstattverfahren zur Rahmenplanung</h3>
            <p>
              Ein wichtiger Meilenstein war das Werkstattverfahren, dessen Ergebnisse derzeit
              in eine Rahmenplanung überführt werden. Diese Rahmenplanung definiert
              übergeordnete Zielsetzungen, städtebauliche Leitlinien und
              Entwicklungsperspektiven für die einzelnen Quartiere.
            </p>
          </div>
          <figure class="planungsstand__figure">
            <Image src={workshopPhoto} alt="Werkstattverfahren: Planungsteams und LCE im Austausch zu den Zukunftsquartieren" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, (max-width: 991px) 45vw, 560px" quality={88} />
          </figure>
        </div>

        <div class="planungsstand__row planungsstand__row--reverse">
          <figure class="planungsstand__figure">
            <Image src={adeptRendering} alt="3D-Visualisierung des Zielkonzepts von ADEPT für die Zukunftsquartiere" widths={[640, 960, 1280, 1600]} sizes="(max-width: 767px) 92vw, (max-width: 991px) 45vw, 560px" quality={88} />
            <figcaption>ADEPT, 2026</figcaption>
          </figure>
          <div class="planungsstand__text">
            <h3>Nächste Schritte &amp; Baurecht</h3>
            <p>
              In den kommenden Schritten erfolgt die weitere Ausarbeitung der Rahmenplanung
              sowie die Schaffung von Baurecht im Rahmen der Bauleitplanung, insbesondere durch
              Flächennutzungs- und Bebauungspläne. Entsprechende politische Beschlüsse sind
              Bestandteil des weiteren Prozesses.
            </p>
            <p>
              Einzelne Entwicklungsbereiche stehen zu unterschiedlichen Zeitpunkten zur
              Verfügung. Frühzeitig entwickelbar sind u.&nbsp;a. das Areal Spedition Frey /
              Deutsche Straße, das ehemalige Rathausgelände sowie Flächen östlich der
              Kreisverwaltung (Ellipsengrundstück). Nachrangig entwickelt werden u.&nbsp;a. das
              Benckiserareal sowie der Bereich des Friedensparks.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Projekt Zukunftsquartiere" title="Downloads & Infomaterial" align="left">
        <p class="lead">
          In unserem Download-Bereich finden Sie alle wichtigen Informationen, Präsentationen
          und Unterlagen zum Projekt „Zukunftsquartiere" gebündelt an einem Ort.
        </p>
      </SectionHeader>

      <div class="downloads">
        {
          downloads.map((group, index) => (
            <div class="accordion__item">
              <button
                class="accordion__trigger"
                type="button"
                aria-controls={`downloads-panel-${index}`}
              >
                <h3>{group.category}</h3>
                <span aria-hidden="true" class="accordion__icon"></span>
              </button>
              <div id={`downloads-panel-${index}`} class="accordion__panel">
                <div class="accordion__panel-inner">
                  {group.items.map((item) => (
                    <div class="downloads__item">
                      <div class="downloads__item-header">
                        <strong>{item.title}</strong>
                        <a href={item.href} class="downloads__link">Herunterladen</a>
                      </div>
                      <p>{item.text}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Followed by a white section — trim bottom padding to match Home's tighter
       hero→section gap. */
    padding-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto auto;
    width: 480px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(161, 173, 70, 0.18), rgba(161, 173, 70, 0) 70%);
    z-index: 0;
    pointer-events: none;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .hero__figure {
    margin: 0;
  }
  .hero__figure :global(img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    width: 100%;
    max-height: 380px;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.45s ease, box-shadow 0.45s ease;
  }
  .hero__figure:hover :global(img) {
    transform: scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }
  .hero__figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__figure :global(img) {
      max-height: 260px;
      aspect-ratio: 16 / 10;
    }
  }

  .bausteine {
    margin-top: 3rem;
  }
  .bausteine__item {
    text-align: center;
  }
  .bausteine__item img {
    margin-inline: auto;
    margin-bottom: 1rem;
    transition: transform 0.25s ease;
  }
  .bausteine__item:hover img {
    transform: translateY(-4px) scale(1.06);
  }
  .bausteine__item h3 {
    margin-bottom: 0.5rem;
  }
  .bausteine__note {
    max-width: 70ch;
    margin: 2.5rem auto 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  .standort-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .standort-card__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .standort-card h3 {
    margin-bottom: 0.4rem;
  }

  .milestone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-light));
    background-size: 200% 200%;
    animation: milestoneBreath 14s ease-in-out infinite;
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  /* langsames, ruhiges „Atmen" des Verlaufs – passt zur Zukunfts-Aussage */
  @keyframes milestoneBreath {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .milestone {
      animation: none;
    }
  }
  .milestone__year {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    line-height: 1;
    color: #fff;
  }
  .milestone p {
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    flex: 1 1 320px;
  }

  .planungsstand__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .planungsstand__row:last-child {
    margin-bottom: 0;
  }
  .planungsstand__row--reverse .planungsstand__figure {
    order: -1;
  }
  .planungsstand__text h3 {
    margin-bottom: 0.75rem;
  }
  .planungsstand__text p:last-child {
    margin-bottom: 0;
  }
  .planungsstand__figure {
    margin: 0;
  }
  .planungsstand__figure :global(img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    width: 100%;
    max-height: 360px;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.45s ease, box-shadow 0.45s ease;
  }
  .planungsstand__figure:hover :global(img) {
    transform: scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }
  .planungsstand__figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 760px) {
    .planungsstand__row,
    .planungsstand__row--reverse {
      grid-template-columns: 1fr;
    }
    .planungsstand__row--reverse .planungsstand__figure {
      order: initial;
    }
    .planungsstand__figure :global(img) {
      max-height: 240px;
      aspect-ratio: 16 / 10;
    }
  }

  .downloads {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .downloads__panel-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .downloads__item-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }
  .downloads__link {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-highlight);
    white-space: nowrap;
  }
  .downloads__link:hover {
    text-decoration: underline;
  }
</style>
