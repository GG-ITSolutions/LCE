<style>
  .legal {
    max-width: 760px;
  }
  .legal h2 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }
  .bildnachweis {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .bildnachweis li {
