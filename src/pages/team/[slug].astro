---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/paths";
import { COMPANY_LINKEDIN } from "../../lib/team";

export async function getStaticPaths() {
  const team = await getCollection("team", ({ data }) => data.hasProfile);
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;
const { data } = member;
const { Content } = await render(member);

const vcardHref = withBase(`/team/${member.slug}.vcf`);
---

<BaseLayout
  title={member.data.name}
  description={`${member.data.name} – ${member.data.role} bei der LCE. Kontaktdaten speichern, per E-Mail, Telefon oder LinkedIn Kontakt aufnehmen.`}
>
  <section class="section vprofile">
    <div class="vcard" data-reveal>
      <div class="vcard__avatar">
        <Image src={data.image} alt={data.name} widths={[220, 330, 440]} sizes="160px" quality={90} />
      </div>
      <h1 class="vcard__name">{data.name}</h1>
      <p class="vcard__role">{data.role}</p>
      <span class="vcard__badge">{data.department}</span>

      <div class="vcard__bio">
        <Content />
      </div>

      <a class="vcard__save" href={vcardHref} download={`${member.slug}.vcf`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Kontakt speichern (vCard)
      </a>

      <div class="linklist">
        <a class="linkbtn" href={`mailto:${data.email}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <polyline points="3 7 12 13 21 7" />
          </svg>
          <span class="linkbtn__label">E-Mail<small>{data.email}</small></span>
          <span class="linkbtn__chev" aria-hidden="true">→</span>
        </a>

        {data.phone && (
          <a class="linkbtn" href={`tel:${data.phone.replace(/[^+\d]/g, "")}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span class="linkbtn__label">Anrufen<small>{data.phone}</small></span>
            <span class="linkbtn__chev" aria-hidden="true">→</span>
          </a>
        )}

        {data.mobile && (
          <a class="linkbtn" href={`tel:${data.mobile.replace(/[^+\d]/g, "")}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="2" width="12" height="20" rx="2" />
              <line x1="11" y1="18" x2="13" y2="18" />
            </svg>
            <span class="linkbtn__label">Mobil<small>{data.mobile}</small></span>
            <span class="linkbtn__chev" aria-hidden="true">→</span>
          </a>
        )}

        {data.linkedin && (
          <a class="linkbtn" href={data.linkedin} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            <span class="linkbtn__label">LinkedIn<small>{data.name}</small></span>
            <span class="linkbtn__chev" aria-hidden="true">→</span>
          </a>
        )}

        {COMPANY_LINKEDIN && (
          <a class="linkbtn" href={COMPANY_LINKEDIN} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            <span class="linkbtn__label">LinkedIn<small>LCE – LU-City Entwicklungs-GmbH</small></span>
            <span class="linkbtn__chev" aria-hidden="true">→</span>
          </a>
        )}
      </div>

      <a class="vcard__back" href={`${withBase("/ueber-uns")}#team`}>← Zurück zum Team</a>
    </div>
  </section>
</BaseLayout>

<style>
  .vprofile {
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }
  /* Soft branded backdrop behind the card */
  .vprofile::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 15% 0%, rgba(161, 173, 70, 0.16), transparent 70%),
      radial-gradient(55% 45% at 100% 20%, rgba(0, 159, 227, 0.14), transparent 70%);
    pointer-events: none;
  }
  .vcard {
    position: relative;
    z-index: 1;
    width: min(100%, 480px);
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }
  .vcard__avatar {
    width: 160px;
    height: 160px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 6px rgba(161, 173, 70, 0.18);
  }
  .vcard__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vcard__name {
    margin: 0 0 0.15rem;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
  }
  .vcard__role {
    margin: 0 0 0.75rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  .vcard__badge {
    display: inline-block;
    background: var(--color-secondary);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.3em 0.8em;
    border-radius: 999px;
  }
  .vcard__bio {
    margin: 1.25rem 0 1.75rem;
    color: var(--color-text-muted);
  }
  .vcard__bio :global(p) {
    margin: 0;
  }

  /* Primary "save contact" button */
  .vcard__save {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.9em 1.25em;
    border-radius: var(--radius-md);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(20, 20, 43, 0.15);
    transition: background-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }
  .vcard__save:hover {
    background: var(--btn-primary-bg-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(161, 173, 70, 0.4);
  }

  /* Stacked Linktree-style buttons */
  .linklist {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .linkbtn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.8em 1em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-secondary);
    text-decoration: none;
    text-align: left;
    transition: border-color var(--transition), background-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }
  .linkbtn svg {
    flex-shrink: 0;
    color: var(--color-primary-dark);
    transition: color var(--transition);
  }
  .linkbtn__label {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-weight: 700;
  }
  .linkbtn__label small {
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    word-break: break-word;
  }
  .linkbtn__chev {
    margin-left: auto;
    color: var(--color-gray);
    transition: transform var(--transition), color var(--transition);
  }
  .linkbtn:hover {
    border-color: var(--color-highlight);
    background: #fbfdff;
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .linkbtn:hover svg,
  .linkbtn:hover .linkbtn__chev {
    color: var(--color-highlight);
  }
  .linkbtn:hover .linkbtn__chev {
    transform: translateX(3px);
  }

  .vcard__back {
    display: inline-block;
    margin-top: 1.75rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-highlight);
    text-decoration: none;
  }
  .vcard__back:hover {
    text-decoration: underline;
  }
</style>
