---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { withBase } from "../lib/paths";
import { Image } from "astro:assets";
import heroImage from "../assets/images/Design-ohne-Titel-36.png";
import teamImage from "../assets/images/Design-ohne-Titel-18.png";
import karteImage from "../assets/images/Zukunftsquartiere-Karte-Helmut-Kohl-Allee.png";

const kennzahlen = [
  {
    value: "39 ha",
    label: "Entwicklungsfläche",
    text: "Die Zukunftsquartiere erstrecken sich über mehrere Entwicklungsbereiche im Kerngebiet Ludwigshafens und umfassen insgesamt eine Fläche von rund 39 Hektar.",
  },
  {
    value: "4 Bausteine",
    label: "Quartierstruktur",
    text: "Die vier zentralen Bausteine Wohnen, Arbeiten, Bildung und Mobilität bilden die konzeptionelle Grundlage der Quartiere und sorgen für eine langfristig tragfähige Nutzungsstruktur.",
  },
  {
    value: "2030",
    label: "Zeithorizont",
    text: "Die Quartiersentwicklung erfolgt etappenweise, gekoppelt an Rückbau und Neubau zentraler Verkehrsstrukturen – mit Zieljahr 2030 für die Fertigstellung der Helmut-Kohl-Allee.",
  },
  {
    value: "Mehrere Baufelder",
    label: "Entwicklungsperspektiven",
    text: "Durch die strategische Lage und Größe des Entwicklungsgebiets entstehen vielfältige Potenziale für unterschiedliche Nutzungs- und Entwicklungsansätze.",
  },
];
---

<BaseLayout
  title="LCE – für Wohnen, Wirtschaft und Innovation in Ludwigshafen"
  description="Die LCE ist die kommunale Entwicklungsgesellschaft der Stadt Ludwigshafen und der GAG. Wir entwickeln die Zukunftsquartiere an der Helmut-Kohl-Allee – transparent und planungssicher."
>
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Kommunale Entwicklungsgesellschaft</p>
        <h1>LCE – für Wohnen, Wirtschaft und Innovation in Ludwigshafen.</h1>
        <p class="lead">
          Als kommunale Entwicklungsgesellschaft schaffen wir die Grundlagen für die neuen
          Stadtquartiere – Schritt für Schritt, transparent und planungssicher.
        </p>
        <div class="hero__actions">
          <a href={withBase("/kontakt")} class="btn btn-primary">Kontakt für Investoren</a>
          <a href={withBase("/ueber-uns")} class="btn btn-secondary btn-on-light">Über die LCE</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__glow" aria-hidden="true"></div>
        <Image
          src={heroImage}
          alt="3D-Visualisierung der geplanten Zukunftsquartiere entlang der Helmut-Kohl-Allee (Konzept ADEPT)"
          class="hero__image"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 767px) 92vw, (max-width: 991px) 48vw, 620px"
          quality={88}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container overview">
      <SectionHeader eyebrow="Wer wir sind" title="Die LCE auf einen Blick" class="overview__intro" />

      <div class="overview__row" data-reveal>
        <div class="overview__text">
          <h3>Gemeinsame Gesellschaft der Stadt &amp; GAG</h3>
          <p>
            Die LCE ist eine gemeinsame Tochter der Stadt Ludwigshafen und der GAG Ludwigshafen.
            Im Mittelpunkt steht die Transformation zentraler Stadtbereiche – insbesondere die
            neuen Stadtquartiere an der geplanten Helmut-Kohl-Allee. Als kommunale
            Entwicklungsgesellschaft bündelt die LCE Expertise aus Stadtplanung,
            Projektsteuerung und Wirtschaft, um zukunftsfähige und nachhaltige Quartiere zu
            realisieren.
          </p>
          <a href={withBase("/ueber-uns")} class="accent-link">Mehr über uns →</a>
        </div>
        <div class="overview__image">
          <Image src={teamImage} alt="Das LCE-Team bespricht das Städtebaumodell der Zukunftsquartiere" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, 48vw" quality={88} />
        </div>
      </div>

      <div class="overview__row overview__row--reverse" data-reveal>
        <div class="overview__image">
          <Image src={karteImage} alt="Lageplan mit dem hervorgehobenen Entwicklungsgebiet der Zukunftsquartiere entlang der Helmut-Kohl-Allee (Quelle: Stadtverwaltung Ludwigshafen am Rhein)" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, 48vw" quality={90} />
        </div>
        <div class="overview__text">
          <h3>Zukunftsquartiere an der Helmut-Kohl-Allee</h3>
          <p>
            Eines der größten städtebaulichen Projekte Deutschlands: Die Zukunftsquartiere
            werden von der LCE im Auftrag der Stadtentwicklung vorangetrieben. Ziel sind
            innovative und nachhaltige Quartiere, die ökonomischen, ökologischen und sozialen
            Herausforderungen gerecht werden.
          </p>
          <a href={withBase("/zukunftsquartiere")} class="accent-link">Mehr zu den Zukunftsquartieren →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Zukunftsquartiere" title="Die wichtigsten Kennzahlen auf einen Blick" />
      <div class="grid grid-4 kennzahlen">
        {
          kennzahlen.map((item) => (
            <div class="stat-tile">
              <div class="kennzahlen__value">{item.value}</div>
              <div class="kennzahlen__label">{item.label}</div>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-card">
        <h2>Sie interessieren sich für Entwicklungspotenziale der Zukunftsquartiere? Sprechen Sie uns an!</h2>
        <a href={withBase("/kontakt")} class="btn btn-primary">Kontakt für Investoren</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .hero__visual {
    position: relative;
  }
  .hero__glow {
    position: absolute;
    inset: -15% -15% auto auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(161, 173, 70, 0.35), rgba(161, 173, 70, 0) 70%);
    z-index: 0;
  }
  .hero__image {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: 420px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .hero__image:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
    }
    .hero__image {
      max-height: 280px;
      aspect-ratio: 16 / 10;
    }
  }

  .overview__intro {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .overview__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .overview__row:last-child {
    margin-bottom: 0;
  }
  .overview__image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .overview__image :global(img) {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    max-height: 360px;
    transition: transform 0.5s ease;
  }
  .overview__image:hover :global(img) {
    transform: scale(1.05);
  }
  .accent-link {
    display: inline-block;
    margin-top: 0.5rem;
    transition: transform var(--transition);
  }
  .accent-link:hover {
    transform: translateX(3px);
  }
  @media (max-width: 760px) {
    .overview__row,
    .overview__row--reverse {
      grid-template-columns: 1fr;
    }
    .overview__row--reverse .overview__image {
      order: -1;
    }
    .overview__image :global(img) {
      aspect-ratio: 16 / 10;
      max-height: 240px;
    }
  }

  .kennzahlen {
    margin-top: 2.5rem;
  }
  .kennzahlen__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    color: var(--color-primary-dark);
  }
  .kennzahlen__label {
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .cta-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-secondary-light) 100%);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  /* Sanft driftende, weich leuchtende Kreise (Hellblau) – wie beim 2030-Meilenstein */
  .cta-card::before,
  .cta-card::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(34px);
    pointer-events: none;
    z-index: 0;
  }
  .cta-card::before {
    width: 260px;
    height: 260px;
    top: -90px;
    left: -60px;
    background: radial-gradient(circle, rgba(0, 159, 227, 0.75), transparent 70%);
    animation: ctaOrbA 14s ease-in-out infinite;
  }
  .cta-card::after {
    width: 300px;
    height: 300px;
    right: -70px;
    bottom: -120px;
    background: radial-gradient(circle, rgba(0, 159, 227, 0.75), transparent 70%);
    animation: ctaOrbB 21s ease-in-out infinite;
  }
  @keyframes ctaOrbA {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(110px, 55px);
    }
  }
  @keyframes ctaOrbB {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-95px, -60px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-card::before,
    .cta-card::after {
      animation: none;
    }
  }
  .cta-card h2 {
    color: #fff;
    max-width: 40ch;
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .cta-card > :global(.btn) {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  import { initHeroReveal, initCountUp } from "../lib/animations";
  initHeroReveal();
  initCountUp();
</script>
