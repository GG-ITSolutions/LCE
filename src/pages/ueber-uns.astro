---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { withBase } from "../lib/paths";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import heroImage from "../assets/images/Design-ohne-Titel-19.png";
import iconMission from "../assets/images/1.png";
import iconGanzheitlich from "../assets/images/2.png";
import iconPlanungssicher from "../assets/images/3.png";
import iconUmsetzung from "../assets/images/4.png";
import sonjaImage from "../assets/images/Sonja-2.png";
import stadtLogo from "../assets/images/Wortmarke-Ludwigshafen.jpg";
import gagLogo from "../assets/images/Design-ohne-Titel-25.png";
import blettnerPortrait from "../assets/images/2_4.png";
import vanVlietPortrait from "../assets/images/1_3.png";

const values = [
  {
    icon: iconMission,
    title: "Mission",
    text: "Die Mission der LCE ist es, zentrale Entwicklungsflächen in Ludwigshafen strategisch weiterzuentwickeln und zukunftsfähige Stadtquartiere zu gestalten.",
  },
  {
    icon: iconGanzheitlich,
    title: "Ganzheitlicher Ansatz",
    text: "Die LCE verfolgt einen ganzheitlichen Ansatz, der städtebauliche Qualität, nachhaltige Konzepte und Entwicklungsperspektiven miteinander verbindet.",
  },
  {
    icon: iconPlanungssicher,
    title: "Planungssichere Rahmenbedingungen",
    text: "Planungssicherheit ist ein Kernauftrag der LCE. Dazu werden Prozesse koordiniert und Grundlagen erarbeitet, damit städtebauliche Planungen verlässlich vorbereitet werden können.",
  },
  {
    icon: iconUmsetzung,
    title: "Umsetzung städtischer Ziele",
    text: "Die LCE schafft die Grundlagen für die Bauleitplanung und treibt durch die Entwicklung und Vermarktung der Flächen die Umsetzung städtebaulicher Ziele voran. Dabei fungiert sie als Schnittstelle und vermittelnde Instanz zwischen Stadtverwaltung, Politik und weiteren Beteiligten.",
  },
];

const history = [
  {
    year: "2003",
    title: "Rheinufer Süd Entwicklungs-GmbH",
    text: `Gründung der Rheinufer Süd Entwicklungs-GmbH (RSE) zur Entwicklung städtebaulich relevanter Flächen und zur Umsetzung zentraler Entwicklungsprojekte in Ludwigshafen. Insbesondere die <a href="${withBase("/documents/Brochure-RSE.pdf")}">Entwicklung des Stadtquartiers Rheinufer Süd</a> prägte die Arbeit der Gesellschaft.`,
  },
  {
    year: "2020",
    title: "LU-City Entwicklungs-GmbH",
    text: "Umfirmierung der RSE zur LU-City Entwicklungs-GmbH (LCE). Neuausrichtung auf strategische, nachhaltige Stadtentwicklung und die Vorbereitung zukünftiger Entwicklungsflächen im Stadtgebiet. Die LCE ist eine gemeinsame Tochter der Stadt Ludwigshafen und der GAG Ludwigshafen.",
  },
  {
    year: "2021–2023",
    title: "Grundlagenermittlungen",
    text: "Durchführung umfassender Grundlagenermittlungen zur Entwicklung der Flächenpotenziale im Zuge des Rückbaus der Hochstraße Nord und des Neubaus der Helmut-Kohl-Allee. Beauftragung des Fraunhofer IAO zur Erarbeitung einer übergeordneten Quartiersstrategie.",
  },
  {
    year: "2023–2024",
    title: "Städtebauliche Vorkonzeption",
    text: "Ausarbeitung einer städtebaulichen Vorkonzeption durch Humpert Architekten mit ersten Ansätzen zur Definition von Baufeldern sowie zur Darstellung planerischer Rahmenbedingungen und Restriktionen.",
  },
  {
    year: "2024–2025",
    title: "Werkstattverfahren",
    text: "Durchführung eines städtebaulichen und freiraumplanerischen Werkstattverfahrens mit drei interdisziplinären Planungsteams. Begleitende Beteiligung der Öffentlichkeit durch Online-Dialog, Bürgerwerkstatt und Bürgerforum.",
  },
  {
    year: "2025",
    title: "Abschluss des Werkstattverfahrens",
    text: "Abschluss des Werkstattverfahrens mit fachlicher Empfehlung der Jury und Überführung der Ergebnisse in die weitere Rahmenplanung der Zukunftsquartiere.",
  },
  {
    year: "2026",
    title: "Rahmenplanung",
    text: "Mit dem Beschluss zur Offenlage und der öffentlichen Auslegung erreicht die Rahmenplanung einen wichtigen Meilenstein. Der Beschluss der finalen Rahmenplanung durch den Stadtrat wird für September 2026 erwartet und bildet die Grundlage für die weitere Entwicklung der Zukunftsquartiere.",
  },
];

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Über die LCE"
  description="Die LCE ist eine gemeinsame Gesellschaft der Stadt Ludwigshafen und der GAG Ludwigshafen. Erfahren Sie mehr über Mission, Geschichte und das Team hinter den Zukunftsquartieren."
>
  <section class="section hero">
    <div class="container hero__grid">
      <div>
        <h1>Über die LCE<br /><span class="hero__sub">Stadtentwicklung mit klarer Verantwortung.</span></h1>
        <p class="lead">
          Die LCE ist eine gemeinsame Gesellschaft der Stadt Ludwigshafen und der GAG
          Ludwigshafen. Als kommunale Entwicklungsgesellschaft verantwortet die LCE die
          Entwicklung und Vermarktung von Bauflächen in Ludwigshafen – im Fokus stehen die
          Flächen entlang der Helmut-Kohl-Allee sowie weitere zentrale Innenstadtlagen.
        </p>
        <div class="hero__actions">
          <a href={withBase("/kontakt")} class="btn btn-primary">Kontakt für Investoren</a>
          <a href={withBase("/zukunftsquartiere")} class="btn btn-secondary btn-on-light">Zukunftsquartiere entdecken</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__glow" aria-hidden="true"></div>
        <Image
          src={heroImage}
          alt="Das LCE-Team im Gespräch am Städtebaumodell der Zukunftsquartiere"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 767px) 92vw, 48vw"
          quality={88}
          loading="eager"
          fetchpriority="high"
          class="hero__image"
        />
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Aufgaben" title="Unser Auftrag" align="left">
        <p class="lead">
          Ein wesentlicher Aufgabenbereich der LCE ist die Vorbereitung und Steuerung
          städtebaulicher Planungen. Dazu gehören die Beauftragung und Koordination von
          Untersuchungen, Planungs- und Machbarkeitsstudien sowie die Organisation von
          Mehrfachbeauftragungen, wie beispielsweise dem Werkstattverfahren zur Erarbeitung
          eines Gesamtkonzepts für die Zukunftsquartiere. Darauf aufbauend begleitet die LCE
          die Beauftragung der Rahmenplanung und koordiniert im weiteren Verlauf die
          anschließende Bauleitplanung sowie die damit verbundenen Planungs- und
          Abstimmungsprozesse.
        </p>
      </SectionHeader>
      <div class="grid grid-2 values">
        {
          values.map((value) => (
            <div class="values__item">
              <Image src={value.icon} alt="" aria-hidden="true" width={56} height={56} />
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-muted" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Historie" title="Unsere Geschichte" />
      <ol class="timeline">
        {
          history.map((entry) => (
            <li class="timeline__item">
              <div class="timeline__year">{entry.year}</div>
              <h3>{entry.title}</h3>
              <p set:html={entry.text} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="team" data-reveal>
    <div class="container">
      <SectionHeader eyebrow="Menschen" title="Unser Team">
        <p class="lead">
          Hinter der LCE steht ein engagiertes Team, das die Entwicklung der Zukunftsquartiere
          in Ludwigshafen verantwortungsvoll begleitet. Von der Geschäftsführung über die
          Projektentwicklung bis zu Marketing und Kommunikation arbeitet das Team eng
          zusammen.
        </p>
      </SectionHeader>
      <div class="card-grid team-grid">
        {
          team.map((member) => {
            const Wrapper = member.data.hasProfile ? "a" : "div";
            const wrapperProps = member.data.hasProfile
              ? { href: withBase(`/team/${member.slug}`) }
              : {};
            return (
              <div class="card team-card">
                <Wrapper class="team-card__image" {...wrapperProps}>
                  <Image src={member.data.image} alt={member.data.name} widths={[250, 380, 500]} sizes="(max-width: 560px) 90vw, 360px" quality={88} />
                  <span class="team-card__badge">{member.data.department}</span>
                </Wrapper>
                <h3>
                  {member.data.hasProfile ? (
                    <a href={withBase(`/team/${member.slug}`)}>{member.data.name}</a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                <a href={`mailto:${member.data.email}`} class="team-card__mail">{member.data.email}</a>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section-muted" data-reveal>
    <div class="container testimonial">
      <div class="testimonial__image">
        <Image src={sonjaImage} alt="Sonja Müller-Zaman, Geschäftsführerin der LCE" widths={[560, 840, 1120]} sizes="(max-width: 767px) 92vw, 40vw" quality={88} />
      </div>
      <div>
        <p class="eyebrow">Wer steht hinter der LCE?</p>
        <h2>Gesellschafter &amp; Geschäftsführung</h2>
        <p>
          Die LCE ist eine gemeinsame Gesellschaft der Stadt Ludwigshafen und der GAG
          Ludwigshafen. Den Vorsitz des Aufsichtsrats führt der Oberbürgermeister der Stadt
          Ludwigshafen, Prof. Dr. Klaus Blettner. Geschäftsführerin der LCE ist Sonja
          Müller-Zaman.
        </p>
        <p class="testimonial__name">Sonja Müller-Zaman<br /><span>Geschäftsführung der LCE</span></p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container testimonial testimonial--reverse">
      <div>
        <Image src={stadtLogo} alt="Wortmarke der Stadt Ludwigshafen am Rhein" width={264} height={64} class="testimonial__logo" />
        <blockquote>
          "Die Entwicklung der Zukunftsquartiere steht exemplarisch für den Wandel und die
          Innovationskraft unserer Stadt. Mit der LU-City Entwicklungs-GmbH haben wir eine
          starke Partnerin, die diese Transformation aktiv gestaltet und wichtige Impulse für
          eine nachhaltige, lebenswerte und wirtschaftlich erfolgreiche Stadtentwicklung
          setzt."
        </blockquote>
        <p class="testimonial__name">Prof. Dr. Klaus Blettner<br /><span>Oberbürgermeister der Stadt Ludwigshafen</span></p>
      </div>
      <div class="testimonial__image">
        <Image src={blettnerPortrait} alt="Prof. Dr. Klaus Blettner, Oberbürgermeister der Stadt Ludwigshafen" widths={[560, 840, 1120]} sizes="(max-width: 767px) 92vw, 40vw" quality={88} />
      </div>
    </div>
  </section>

  <section class="section section-muted" data-reveal>
    <div class="container testimonial">
      <div class="testimonial__image">
        <Image src={vanVlietPortrait} alt="Wolfgang van Vliet, Vorstand der GAG Ludwigshafen" widths={[560, 840, 1120]} sizes="(max-width: 767px) 92vw, 40vw" quality={88} />
      </div>
      <div>
        <Image src={gagLogo} alt="Logo der GAG Ludwigshafen" width={220} height={70} class="testimonial__logo" />
        <blockquote>
          "Mit der LU-City Entwicklungs-GmbH bündeln die Stadt Ludwigshafen und die GAG
          Kompetenzen, um die Stadtentwicklung Ludwigshafens aktiv und nachhaltig
          voranzutreiben. Aus Sicht der GAG ist die LCE damit ein wichtiger Impulsgeber und
          Treiber in der gezielten Vermarktung von zukunftsorientierten Bauflächen und Lagen."
        </blockquote>
        <p class="testimonial__name">Wolfgang van Vliet<br /><span>Vorstand der GAG Ludwigshafen</span></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero is followed by a white section, so trim its bottom padding to keep the
     gap to the first section as tight as on Home (where a grey section follows). */
  .hero {
    padding-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero__sub {
    color: var(--color-primary-dark);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .hero__visual {
    position: relative;
  }
  .hero__glow {
    position: absolute;
    inset: -15% -15% auto auto;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 159, 227, 0.25), rgba(0, 159, 227, 0) 70%);
    z-index: 0;
  }
  .hero__image {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    width: 100%;
    max-height: 420px;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .hero__image:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
    }
    .hero__image {
      max-height: 280px;
      aspect-ratio: 16 / 10;
    }
  }

  .lead {
    margin-bottom: 2.5rem;
  }
  .values {
    row-gap: 2.5rem;
  }
  .values__item img {
    margin-bottom: 1rem;
    transition: transform 0.25s ease;
  }
  .values__item:hover img {
    transform: translateY(-4px) scale(1.06);
  }
  .values__item h3 {
    margin-bottom: 0.5rem;
  }

  /* Vertical timeline: a gradient rail that draws in on scroll, with a dot per
     entry that grows on hover. */
  .timeline {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0 0 0 3rem;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }
  /* Base track (faint, full height) */
  .timeline::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--color-border);
  }
  /* Progress fill – its height follows scroll via the --tl-progress variable
     (0→1) set in JS. It overlays the base track from the top down. */
  .timeline::after {
    content: "";
    position: absolute;
    left: 9px;
    top: 8px;
    width: 2px;
    border-radius: 2px;
    height: calc(var(--tl-progress, 0) * (100% - 16px));
    background: linear-gradient(180deg, var(--color-primary), var(--color-highlight));
    transition: height 0.15s linear;
  }
  .timeline__item {
    position: relative;
  }
  .timeline__item::before {
    content: "";
    position: absolute;
    left: -3rem;
    top: 4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 3px solid var(--color-primary);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  /* Dot turns blue once the scrolling fill line has reached it */
  .timeline__item.is-active::before {
    background: var(--color-highlight);
    border-color: var(--color-highlight);
    box-shadow: 0 0 0 5px rgba(0, 159, 227, 0.16);
  }
  .timeline__year {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.35rem;
  }
  .timeline__item h3 {
    margin-bottom: 0.4rem;
  }
  .timeline__item :global(a) {
    color: var(--color-highlight);
    font-weight: 600;
  }

  /* 3 cards per row on desktop (5 members → 3 + 2 centered), 2 on tablet, 1 on mobile */
  .team-grid > :global(*) {
    flex-basis: 320px;
    max-width: 380px;
  }
  .team-card {
    text-align: center;
  }
  .team-card__image {
    position: relative;
    display: block;
    margin-bottom: 1rem;
    text-decoration: none;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .team-card__image :global(img) {
    border-radius: var(--radius-md);
    aspect-ratio: 1;
    object-fit: cover;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  /* Whole-card hover: image zoom + badge pops to the brand olive + name turns blue */
  .team-card:hover .team-card__image :global(img) {
    transform: scale(1.05);
  }
  .team-card:hover .team-card__badge {
    background: var(--btn-primary-bg);
    color: #fff;
    transform: rotate(-3deg) scale(1.05);
  }
  .team-card:hover h3 a {
    color: var(--color-highlight);
  }
  .team-card__badge {
    transition: background-color var(--transition), color var(--transition), transform var(--transition);
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card:hover .team-card__badge {
      transform: none;
    }
  }
  .team-card h3 a {
    transition: color var(--transition);
  }
  .team-card__badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--color-secondary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.3em 0.7em;
    border-radius: 999px;
  }
  .team-card h3 {
    margin-bottom: 0.25rem;
    font-size: 1.15rem;
  }
  .team-card h3 a {
    text-decoration: none;
    color: var(--color-secondary);
  }
  .team-card__mail {
    font-size: 0.9rem;
    word-break: break-word;
  }

  .testimonial {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .testimonial--reverse {
    grid-template-columns: 1.15fr 0.85fr;
  }
  .testimonial--reverse > div:first-child {
    order: 1;
  }
  .testimonial--reverse .testimonial__image {
    order: 2;
  }
  .testimonial__image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .testimonial__image :global(img) {
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 480px;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.4s ease;
  }
  .testimonial__image:hover :global(img) {
    transform: scale(1.04);
  }
  .testimonial__logo {
    margin-bottom: 1.5rem;
    height: auto;
  }
  .testimonial blockquote {
    position: relative;
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-text);
    padding-left: 1.5rem;
  }
  .testimonial blockquote::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-highlight), var(--color-primary));
    background-size: 100% 200%;
    background-position: 0 0;
    transform-origin: top;
    transition: box-shadow 0.3s ease;
  }
  /* On hover: the olive→blue gradient gently flows downward and the bar gets a
     soft blue glow — calm, no thickening. */
  @media (prefers-reduced-motion: no-preference) {
    .testimonial:hover blockquote::before {
      animation: barFlow 3s linear infinite;
      box-shadow: 0 0 10px rgba(0, 159, 227, 0.55);
    }
  }
  @keyframes barFlow {
    to {
      background-position: 0 -200%;
    }
  }
  /* Bar grows from the top when the testimonial scrolls into view */
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal].is-visible .testimonial blockquote::before {
      animation: barGrow 0.7s ease 0.1s both;
    }
  }
  @keyframes barGrow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .testimonial__name {
    font-weight: 700;
    color: var(--color-secondary);
  }
  .testimonial__name span {
    display: block;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  @media (max-width: 760px) {
    .testimonial,
    .testimonial--reverse {
      grid-template-columns: 1fr;
    }
    .testimonial--reverse > div:first-child,
    .testimonial--reverse .testimonial__image {
      order: initial;
    }
    .testimonial__image {
      order: -1;
    }
    .testimonial__image :global(img) {
      max-height: 280px;
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  // Scroll-driven timeline: the gradient fill grows as you scroll, and each dot
  // turns blue the moment the fill line reaches it.
  const timeline = document.querySelector<HTMLElement>(".timeline");
  if (timeline) {
    const items = Array.from(timeline.querySelectorAll<HTMLElement>(".timeline__item"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      // No animation: show the final state (full line, all dots active).
      timeline.style.setProperty("--tl-progress", "1");
      items.forEach((it) => it.classList.add("is-active"));
    } else {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = timeline.getBoundingClientRect();
        const triggerY = window.innerHeight * 0.55;
        const progress = Math.min(1, Math.max(0, (triggerY - rect.top) / rect.height));
        timeline.style.setProperty("--tl-progress", String(progress));
        items.forEach((it) => {
          const r = it.getBoundingClientRect();
          const dotY = r.top + 14; // dot sits near the top of each entry
          it.classList.toggle("is-active", dotY <= triggerY);
        });
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", update);
    }
  }
</script>
