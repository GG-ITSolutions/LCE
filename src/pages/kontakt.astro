---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { withBase } from "../lib/paths";
import { Image } from "astro:assets";
import iconMail from "../assets/images/1_2.png";
import iconPhone from "../assets/images/2_3.png";
import iconLocation from "../assets/images/3_2.png";

const faqs = [
  {
    question: "Wer ist die LCE und was macht sie?",
    answer:
      "Die LCE LU-City Entwicklungs-GmbH koordiniert die Entwicklung eines neuen Stadtquartiers im Auftrag der Stadt Ludwigshafen. Ziel ist es, ein lebenswertes und nachhaltiges Stadtquartier zu schaffen.",
  },
  {
    question: "Was ist der aktuelle Planungsschritt?",
    answer:
      "Im Anschluss an das von der LCE organisierte Werkstattverfahren wird aktuell ein städtebaulicher Rahmenplan erarbeitet. Dabei dient das Zielkonzept des international anerkannten Büros ADEPT (Kopenhagen, Hamburg), das im Werkstattverfahren überzeugt hat, als fachliche Grundlage für die weitere Entwicklung des Planungsgebiets rund um die künftige Helmut-Kohl-Allee. Der Stadtrat hat am 22. September 2025 der Weiterverfolgung dieses Zielkonzepts zugestimmt.",
  },
  {
    question: "Was ist ein Rahmenplan?",
    answer:
      "Ein Rahmenplan ist ein informelles, also nicht rechtsverbindliches Planungsinstrument. Er konkretisiert städtebauliche Ziele, legt funktionale und gestalterische Leitlinien fest und schafft damit die Grundlage für eine geordnete städtebauliche Entwicklung. Zudem dient er als Orientierung für Verwaltung, Eigentümer*innen und Investor*innen und bildet die Basis für spätere Bauleitplanverfahren.",
  },
];
---

<BaseLayout
  title="Kontakt"
  description="Nehmen Sie Kontakt zur LCE auf – für Investitionsanfragen, Projektbezug oder allgemeine Anliegen rund um die Zukunftsquartiere in Ludwigshafen."
>
  <section class="section">
    <div class="container kontakt-grid">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h1>Mit der LCE ins Gespräch kommen</h1>
        <p class="lead">
          Ob Investitionsanfrage, Projektbezug oder allgemeines Anliegen: Nutzen Sie das
          Kontaktformular oder wenden Sie sich direkt an die passende Stelle.
        </p>

        <form method="POST" action="/formular/kontakt.php" class="kontakt-form">
          <p class="kontakt-form__note">Mit <span class="req-mark">*</span> markierte Felder sind Pflichtfelder.</p>
          <div class="kontakt-form__grid">
            <div class="field">
              <label for="Vor--und-Nachname">Vor- und Nachname <span class="req-mark" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="Vor--und-Nachname"
                name="Vor--und-Nachname"
                placeholder="Max Mustermann"
                maxlength="256"
                autocomplete="name"
                required
                aria-required="true"
              />
              <p class="field__error">Bitte geben Sie Ihren Namen ein.</p>
            </div>
            <div class="field">
              <label for="E-Mail">E-Mail <span class="req-mark" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="E-Mail"
                name="E-Mail"
                placeholder="mustermann@beispiel.de"
                maxlength="256"
                autocomplete="email"
                inputmode="email"
                required
                aria-required="true"
              />
              <p class="field__error">Bitte geben Sie eine gültige E-Mail-Adresse ein (z.&nbsp;B. name@beispiel.de).</p>
            </div>
            <div class="field">
              <label for="Telefonnummer">Telefonnummer</label>
              <input
                type="tel"
                id="Telefonnummer"
                name="Telefonnummer"
                placeholder="+49 621 12345678"
                maxlength="256"
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
            <div class="field">
              <label for="Unternehmen">Unternehmen</label>
              <input type="text" id="Unternehmen" name="Unternehmen" placeholder="Mustermann GmbH" maxlength="256" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="Kategorie">Kategorie</label>
              <select id="Kategorie" name="Kategorie">
                <option value="Allgemeine Anfrage">Allgemeine Anfrage</option>
                <option value="Investorenanfrage">Investorenanfrage</option>
                <option value="Kooperation">Kooperation</option>
                <option value="Presseanfrage">Presseanfrage</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="Nachricht">Nachricht <span class="req-mark" aria-hidden="true">*</span></label>
              <textarea id="Nachricht" name="Nachricht" maxlength="5000" placeholder="Geben Sie Ihre Nachricht ein.." rows="5" required aria-required="true"></textarea>
              <p class="field__error">Bitte geben Sie eine Nachricht ein.</p>
            </div>

            <!--
              Honeypot: unsichtbar für Menschen, aber für einfache Bots ausfüllbar.
              Serverseitig (kontakt.php): Nachrichten mit ausgefülltem "Details"-Feld verwerfen.
            -->
            <div class="field field--full honeypot" aria-hidden="true">
              <label for="Details">Details</label>
              <input type="text" id="Details" name="Details" tabindex="-1" autocomplete="off" />
            </div>

            <div class="field field--full">
              <label class="checkbox">
                <input type="checkbox" id="Datenschutz" name="Datenschutz" required aria-required="true" />
                <span>
                  Ich akzeptiere die <a href={withBase("/datenschutz")}>Datenschutzbestimmungen</a> <span class="req-mark" aria-hidden="true">*</span>. Mit
                  dem Absenden des Formulars stimmen Sie der Verarbeitung Ihrer Angaben zur
                  Bearbeitung Ihrer Anfrage zu.
                </span>
              </label>
              <p class="field__error field__error--checkbox">Bitte akzeptieren Sie die Datenschutzbestimmungen.</p>
            </div>

            <button type="submit" class="btn btn-primary field--full">Anfrage absenden</button>
          </div>
        </form>
      </div>

      <div class="card kontakt-card">
        <h3>Kontaktdaten</h3>
        <div class="kontakt-links">
          <a href="mailto:info@lce-ludwigshafen.de" class="kontakt-link">
            <Image src={iconMail} alt="" aria-hidden="true" width={40} height={40} />
            <div>
              <div class="kontakt-link__label">E-Mail</div>
              <div class="kontakt-link__value">info@lce-ludwigshafen.de</div>
            </div>
          </a>
          <a href="tel:+496215604147" class="kontakt-link">
            <Image src={iconPhone} alt="" aria-hidden="true" width={40} height={40} />
            <div>
              <div class="kontakt-link__label">Telefon</div>
              <div class="kontakt-link__value">+49 (621) 5604&nbsp;-147</div>
            </div>
          </a>
          <a href="https://share.google/wubZgkQn577MtZXXU" target="_blank" rel="noopener noreferrer" class="kontakt-link">
            <Image src={iconLocation} alt="" aria-hidden="true" width={40} height={40} />
            <div>
              <div class="kontakt-link__label">Standort</div>
              <div class="kontakt-link__value">Mundenheimer Str. 182<br />67061 Ludwigshafen am Rhein</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionHeader title="FAQ – Häufig gestellte Fragen">
        <p class="lead">
          Hier finden Sie Antworten auf häufig gestellte Fragen rund um unsere Projekte,
          Ziele und Kontaktmöglichkeiten. Unser Team steht Ihnen jederzeit zur Verfügung, um
          Fragen zu beantworten.
        </p>
      </SectionHeader>
      <div class="faq" style="max-width: 820px; margin-inline: auto;">
        {
          faqs.map((faq, index) => (
            <div class="accordion__item">
              <button
                class="accordion__trigger"
                type="button"
                aria-controls={`faq-panel-${index}`}
              >
                <h3>{faq.question}</h3>
                <span aria-hidden="true" class="accordion__icon" />
              </button>
              <div id={`faq-panel-${index}`} class="accordion__panel">
                <div class="accordion__panel-inner">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kontakt-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .kontakt-grid {
      grid-template-columns: 1fr;
    }
  }

  .kontakt-form {
    margin-top: 2rem;
  }
  .kontakt-form__note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .req-mark {
    color: var(--color-highlight);
    font-weight: 700;
  }
  .kontakt-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 560px) {
    .kontakt-form__grid {
      grid-template-columns: 1fr;
    }
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75em 1em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font: inherit;
    background: #fff;
    color: var(--color-text);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .field textarea {
    resize: vertical;
  }
  /* Inline validation: only after the user has interacted (native :user-invalid) */
  .field__error {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: #b3261e;
    display: none;
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: #b3261e;
  }
  .field input:user-invalid ~ .field__error,
  .field textarea:user-invalid ~ .field__error {
    display: block;
  }
  .field:has(#Datenschutz:user-invalid) .field__error--checkbox {
    display: block;
  }
  .checkbox {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .checkbox input {
    margin-top: 0.2rem;
    width: auto;
  }
  .honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  button.btn {
    border: none;
  }

  .kontakt-card h3 {
    margin-bottom: 1.25rem;
  }
  .kontakt-links {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .kontakt-link {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    text-decoration: none;
    color: var(--color-text);
  }
  .kontakt-link__label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .kontakt-link__value {
    font-weight: 700;
    color: var(--color-secondary);
  }

  .faq .accordion__trigger h3 {
    font-size: 1.05rem;
  }
  .faq .accordion__panel-inner p {
    margin: 0;
  }
</style>
